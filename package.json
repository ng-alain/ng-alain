{
  "name": "ng-alain",
  "version": "21.3.0",
  "description": "ng-zorro-antd admin panel front-end framework",
  "author": "cipchk <cipchk@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-alain/ng-alain.git"
  },
  "bugs": {
    "url": "https://github.com/ng-alain/ng-alain/issues"
  },
  "homepage": "https://ng-alain.com",
  "license": "MIT",
  "keywords": [
    "delon",
    "antd",
    "ng-zorro-antd",
    "angular",
    "component",
    "scaffold"
  ],
  "scripts": {
    "prepare": "husky install",
    "start": "ng s -o",
    "hmr": "ng s -o --hmr",
    "build": "ng b",
    "analyze": "ng b --source-map",
    "analyze:view": "source-map-explorer dist/**/*.js --no-border-checks",
    "lint": "npm run lint:ts && npm run lint:style",
    "lint:ts": "ng lint",
    "lint:style": "npx stylelint 'src/**/*.less'",
    "test": "ng test",
    "test-coverage": "ng test -c coverage --coverage --watch=false",
    "color-less": "ng-alain-plugin-theme -t=colorLess",
    "theme": "ng-alain-plugin-theme -t=themeCss",
    "icon": "ng g ng-alain:plugin icon"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@delon/abc": "^22.0.0-next.1",
    "@delon/acl": "^22.0.0-next.1",
    "@delon/auth": "^22.0.0-next.1",
    "@delon/cache": "^22.0.0-next.1",
    "@delon/chart": "^22.0.0-next.1",
    "@delon/form": "^22.0.0-next.1",
    "@delon/mock": "^22.0.0-next.1",
    "@delon/theme": "^22.0.0-next.1",
    "@delon/util": "^22.0.0-next.1",
    "@ng-util/monaco-editor": "^22.0.0",
    "ng-zorro-antd": "^22.0.1",
    "ngx-tinymce": "^22.0.0",
    "rxjs": "~7.8.0",
    "screenfull": "^6.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@delon/testing": "^22.0.0-next.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "ng-alain": "^22.0.0-next.1",
    "ng-alain-plugin-theme": "^18.0.0",
    "prettier": "^3.9.6",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "(src)/**/*.{html,ts}": [
      "eslint --cache"
    ],
    "(src)/**/*.less": [
      "npm run lint:style"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
